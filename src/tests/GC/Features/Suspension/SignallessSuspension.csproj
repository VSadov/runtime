<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- Threads that spin without transitions make GC stress impractically slow -->
    <GCStressIncompatible>true</GCStressIncompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NativeAOT compiles the code for signalless mode, which then needs no environment variable -->
    <IlcSignalless>true</IlcSignalless>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />

    <CLRTestEnvironmentVariable Include="DOTNET_signalless" Value="1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
